<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Đọc ảnh từ bộ nhớ (Android 12 trở xuống) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Đọc ảnh từ bộ nhớ (Android 13 trở lên) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JobSearchApp"
        tools:targetApi="31">

        <!-- Màn hình chính (Chạy đầu tiên để cho phép xem trước) -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Đăng nhập/Đăng ký -->
        <activity
            android:name=".ui.activities.AuthActivity"
            android:exported="false" />

        <!-- Màn hình Nhà tuyển dụng -->
        <activity
            android:name=".ui.activities.EmployerActivity"
            android:exported="false" />

        <!-- Các màn hình chức năng của Nhà tuyển dụng -->
        <activity android:name=".ui.activities.PostJobActivity" android:exported="false" />
        <activity
            android:name=".ui.activities.ManageJobsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activities.ViewApplicantsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activities.ApplicantDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.SavedJobsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.JobDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.EditJobActivity"
            android:exported="false" />

    </application>
</manifest>