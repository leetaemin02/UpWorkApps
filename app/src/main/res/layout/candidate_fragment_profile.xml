<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Giao diện khi CHƯA đăng nhập -->
        <LinearLayout
            android:id="@+id/layout_guest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/gray_border" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám phá tính năng cá nhân"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToAuth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Đăng nhập / Đăng ký"
                android:layout_marginTop="24dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- GIAO DIỆN NHÀ TUYỂN DỤNG (PROFILE) -->
        <LinearLayout
            android:id="@+id/layout_employer_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Employer Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivEmployerAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/ic_default_avatar"
                        android:scaleType="centerCrop"
                        android:background="@color/gray_light"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvEmployerCompanyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên Công Ty"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvEditEmployerAvatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đổi Logo công ty"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin liên hệ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvEmployerEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email công ty"
                        android:drawableStart="@android:drawable/ic_dialog_email"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginVertical="12dp"/>

                    <TextView
                        android:id="@+id/tvEmployerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Số điện thoại công ty"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Company Intro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giới thiệu chung"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvEmployerDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Mô tả về công ty của bạn..."
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_main"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa chỉ công ty"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvEmployerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Địa chỉ trụ sở chính"
                    android:drawableStart="@android:drawable/ic_menu_mylocation"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_main"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditEmployerProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa thông tin công ty"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="32dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutEmployer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng xuất"
                android:textColor="@color/error"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="start"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/error" />
        </LinearLayout>

        <!-- GIAO DIỆN ỨNG VIÊN (Hiển thị khi role = CANDIDATE) -->
        <LinearLayout
            android:id="@+id/layout_logged_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Profile Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfileAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@android:drawable/sym_def_app_icon"
                        android:scaleType="centerCrop"
                        android:background="@color/gray_light"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Họ và tên"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvEditAvatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sửa avatar"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin liên hệ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:drawableStart="@android:drawable/ic_dialog_email"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginVertical="12dp"/>

                    <TextView
                        android:id="@+id/tvProfileLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Địa điểm"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CV Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadCV"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Tải lên CV mới"
                android:textAllCaps="false"
                android:layout_marginTop="24dp"
                app:icon="@android:drawable/ic_menu_upload"
                app:cornerRadius="12dp" />

            <!-- Danh sách CV -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Danh sách CV" android:textStyle="bold" android:textSize="16sp"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:id="@+id/layout_cv_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_search_bar"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_pdf_red"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvCvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My_CV.pdf"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                            <TextView
                                android:id="@+id/tvCvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhấn để xem hoặc tải về"
                                android:textSize="11sp"
                                android:textColor="@color/text_sub"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/ivDeleteCv"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_delete"
                            app:tint="@color/error"
                            android:padding="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSavedJobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/yellow_star"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Công việc đã lưu" android:layout_marginStart="16dp" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kỹ năng chuyên môn -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kỹ năng chuyên môn" android:textStyle="bold" android:textSize="16sp"/>
                        <ImageView
                            android:id="@+id/ivAddSkill"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:src="@android:drawable/ic_menu_add"
                            app:tint="@color/primary"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgProfileSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp">
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa thông tin cá nhân"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="24dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng xuất"
                android:textColor="@color/error"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="start"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/error" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
