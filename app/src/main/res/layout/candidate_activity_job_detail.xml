<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_share"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivHeart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/btn_star"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivShare" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Thông báo trạng thái ứng tuyển -->
    <TextView
        android:id="@+id/tvAppliedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:background="#E3F2FD"
        android:padding="12dp"
        android:text="Trạng thái đơn: Đang xem xét"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvAppliedStatus"
        android:layout_above="@id/btnApplyContainer"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gray_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetailLogo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@android:drawable/sym_def_app_icon"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        android:background="@color/gray_light"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chuyên viên Phân tích Dữ liệu"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginTop="12dp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvDetailCompany"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TechCorp Solutions"
                        android:textColor="@color/text_sub"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quận 1, TP. Hồ Chí Minh"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:drawablePadding="4dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border"
                        android:layout_marginVertical="16dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">
                        <!-- Info items like Salary, Exp... -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MỨC LƯƠNG" android:textSize="10sp" android:textColor="@color/text_sub"/>
                            <TextView android:id="@+id/tvDetailSalary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25 - 40 Triệu" android:textColor="@color/primary" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KINH NGHIỆM" android:textSize="10sp" android:textColor="@color/text_sub"/>
                            <TextView android:id="@+id/tvDetailExp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 - 5 Năm" android:textColor="@color/text_main" android:textStyle="bold"/>
                        </LinearLayout>
                    </GridLayout>

                    <TextView
                        android:id="@+id/tvDetailDeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hạn nộp: Còn 0 ngày"
                        android:textColor="#F44336"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sections -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mô tả công việc" android:textStyle="bold" android:layout_marginTop="24dp" android:textSize="16sp" android:textColor="@color/text_main" android:drawableStart="@drawable/bg_tag" android:drawablePadding="8dp"/>
            <TextView android:id="@+id/tvDetailDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Mô tả chi tiết tại đây..." android:textColor="@color/text_main" android:lineSpacingExtra="4dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yêu cầu ứng viên" android:textStyle="bold" android:layout_marginTop="24dp" android:textSize="16sp" android:textColor="@color/text_main" android:drawableStart="@drawable/bg_tag" android:drawablePadding="8dp"/>
            <TextView android:id="@+id/tvDetailReq" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Yêu cầu chi tiết tại đây..." android:textColor="@color/text_main" android:lineSpacingExtra="4dp"/>

            <!-- Địa điểm section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Địa điểm" android:textStyle="bold" android:layout_marginTop="24dp" android:textSize="16sp" android:textColor="@color/text_main" android:drawableStart="@drawable/bg_tag" android:drawablePadding="8dp"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="@color/gray_light">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:src="@android:drawable/ic_dialog_map"/>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvDetailFullAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Địa chỉ chi tiết của công ty..." android:textSize="13sp" android:textColor="@color/text_sub"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Apply Button -->
    <LinearLayout
        android:id="@+id/btnApplyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Nộp hồ sơ ngay"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"/>
    </LinearLayout>

</RelativeLayout>