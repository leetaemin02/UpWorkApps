<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCompanyLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="@color/gray_light"
            android:padding="8dp"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Senior UX Designer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/ivCompanyLogo"
            app:layout_constraintStart_toEndOf="@id/ivCompanyLogo"
            app:layout_constraintEnd_toStartOf="@id/ivBookmark" />

        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Google"
            android:textSize="12sp"
            android:textColor="@color/text_sub"
            app:layout_constraintTop_toBottomOf="@id/tvJobTitle"
            app:layout_constraintStart_toStartOf="@id/tvJobTitle"
            app:layout_constraintEnd_toEndOf="@id/tvJobTitle" />

        <ImageView
            android:id="@+id/ivBookmark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/btn_star"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/llTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/ivCompanyLogo">

            <TextView
                android:id="@+id/tvJobCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh mục"
                android:textSize="10sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_tag"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/tvJobExp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kinh nghiệm"
                android:textSize="10sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_tag"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_sub" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivLocationIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@android:drawable/ic_menu_mylocation"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/llTags"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvJobLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hồ Chí Minh"
            android:textSize="12sp"
            android:textColor="@color/text_sub"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
            app:layout_constraintStart_toEndOf="@id/ivLocationIcon" />

        <TextView
            android:id="@+id/tvJobSalary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$3,500 - $5,000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            app:layout_constraintBottom_toBottomOf="@id/tvJobLocation"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>